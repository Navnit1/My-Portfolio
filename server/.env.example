# Port the Express API listens on
PORT=5050

# The deployed frontend URL (for CORS). Use http://localhost:5173 in local dev.
CLIENT_URL=http://localhost:5173

# ── Not yet used by this starter, but needed if you build out the
# full spec (MongoDB, auth, Cloudinary, AI assistant). Kept here so
# the shape is documented up front — see docs/EDITING_YOUR_PORTFOLIO.md.
# MONGODB_URI=
# JWT_SECRET=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# AI_API_KEY=
# AI_MODEL=
RESEND_API_KEY=your_resend_api_key_here